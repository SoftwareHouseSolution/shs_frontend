# Copy to .env.local (development) or set in the build/runtime environment.

# Public base URL of the Django API, including /api/v1. Used by the browser (contact form)
# and, unless API_INTERNAL_URL is set, by the server when rendering pages.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: a private address the Next.js server should use instead (e.g. http://backend:8000/api/v1
# inside Docker). Never sent to the browser.
# API_INTERNAL_URL=

# Public origin of this site, for absolute URLs in metadata (Open Graph, canonical).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How long (seconds) a fetched CMS response is reused on `next start` before refetching.
# Edits in the admin appear within this window. Ignored by the static export, which
# fetches once at build time.
CMS_REVALIDATE_SECONDS=60
